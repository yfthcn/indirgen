# Copy to .env and adjust. .env is ignored by git.

# Owner of the data and downloads folders (id -u / id -g).
PUID=1000
PGID=1000

# Address and port on the host. 127.0.0.1 = this machine only.
# For the phone/other devices use the LAN or VPN address of the host.
INDIRGEN_BIND=127.0.0.1
INDIRGEN_PORT=8899

# Folders on the host.
INDIRGEN_DATA_DIR=./data
INDIRGEN_DOWNLOAD_DIR=./downloads

# Time zone (night hours, log times).
TZ=UTC

# Host names you open İndirgen with (comma separated). IP addresses always work.
INDIRGEN_ALLOWED_HOSTS=

# Image tag: latest or a version like v1.0.0.
INDIRGEN_TAG=latest
